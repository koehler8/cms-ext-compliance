{
  "commands": [
    "test \"$(npm -v | cut -d. -f1,2)\" = 10.9 || { echo \"verify: npm $(npm -v) is not the pinned 10.9.x\" >&2; exit 1; }",
    "npm ci --no-audit --no-fund",
    "node -e \"const c=JSON.parse(require('fs').readFileSync('extension.config.json','utf8')); if(!c||typeof c!=='object') process.exit(1)\"",
    "npm pack --dry-run --json > /dev/null",
    "npm test --if-present"
  ],
  "releasePlan": "echo '{\"release\": false}'"
}
